# AegisAgent Environment Configuration
# Copy this file to .env and fill in your values

# ── Required: SoSoValue API (primary data source) ──
SOSO_API_KEY=

# ── AI Providers (at least one required for narrative generation) ──
# Prefer Venice.ai for sovereign, private inference
VENICE_API_KEY=
# Groq as fallback (free tier available)
GROQ_API_KEY=

# ── On-chain Data ──
MORALIS_API_KEY=

# ── Agentic Finance (Uniswap swap routing) ──
UNISWAP_API_KEY=

# ── Blockchain Signing ──
# Private key for Celo on-chain sealing and Status Network beacons
PRIVATE_KEY=
# Agent wallet address (used for on-chain identity)
AGENT_WALLET=0xE32A943635107CA464a2c1328EFf34AE0bFa8247

# ── Telegram Alerts ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Caching (Upstash Redis) ──
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Social Publishing ──
MOLTBOOK_API_KEY=
