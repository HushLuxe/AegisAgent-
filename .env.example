# AegisAgent Environment Configuration
# Copy this file to .env and fill in your values

# ── Required: SoSoValue API (primary data source) ──
SOSO_API_KEY=

# ── AI Providers (at least one required for narrative generation) ──
VENICE_API_KEY=
GROQ_API_KEY=

# ── On-chain Data ──
MORALIS_API_KEY=

# ── Telegram Alerts ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Caching (Upstash Redis) ──
KV_REST_API_URL=
KV_REST_API_TOKEN=
